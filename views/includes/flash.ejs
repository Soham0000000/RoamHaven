<div class="toast-notification-wrapper">
  <% if(success && success.length){ %>
    <div class="alert alert-custom alert-success-custom alert-dismissible fade show shadow-lg" role="alert" id="successToast">
      <div class="alert-icon-box text-success">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <div class="alert-text-box">
        <strong>Success!</strong>
        <p class="mb-0"><%= success %></p>
      </div>
      <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if(error && error.length){ %>
    <div class="alert alert-custom alert-danger-custom alert-dismissible fade show shadow-lg" role="alert" id="errorToast">
      <div class="alert-icon-box text-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
      </div>
      <div class="alert-text-box">
        <strong>Notice</strong>
        <p class="mb-0"><%= error %></p>
      </div>
      <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
</div>