<%- layout("/layouts/boilerplate") -%>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-7 col-sm-10">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden auth-card">
        <!-- Auth Header -->
        <div class="auth-header text-center p-4 border-bottom">
          <div class="brand-icon-wrapper mx-auto mb-2">
            <i class="fa-solid fa-compass brand-icon"></i>
          </div>
          <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
          <p class="text-muted small mb-0">Log in to manage your havens and bookings</p>
        </div>

        <div class="card-body p-4 p-md-5">
          <form action="/login" method="POST" class="needs-validation" novalidate>
            <!-- Username -->
            <div class="mb-3">
              <label for="username" class="form-label fw-semibold text-dark small">Username</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                <input 
                  name="username" 
                  type="text" 
                  id="username" 
                  class="form-control border-start-0 ps-0" 
                  placeholder="Enter your username" 
                  required
                >
                <div class="invalid-feedback">Please enter your username.</div>
              </div>
            </div>

            <!-- Password with Show/Hide Toggle -->
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <label for="password" class="form-label fw-semibold text-dark small mb-0">Password</label>
                <a href="#" class="small text-decoration-none text-muted" onclick="alert('Password reset link simulated.'); return false;">Forgot?</a>
              </div>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                <input 
                  name="password" 
                  type="password" 
                  id="password" 
                  class="form-control border-start-0 border-end-0 px-0 password-input" 
                  placeholder="Enter your password" 
                  required
                >
                <button type="button" class="input-group-text bg-light border-start-0 password-toggle-btn" title="Toggle password visibility">
                  <i class="fa-regular fa-eye text-muted"></i>
                </button>
                <div class="invalid-feedback">Please enter your password.</div>
              </div>
            </div>

            <!-- Submit Button -->
            <button class="btn btn-primary-gradient w-100 py-3 rounded-pill text-white fw-bold shadow-sm mb-3">
              Log In to RoamHaven
            </button>

            <!-- Social Divider -->
            <div class="d-flex align-items-center my-3">
              <hr class="flex-grow-1 my-0">
              <span class="px-3 small text-muted text-uppercase">or</span>
              <hr class="flex-grow-1 my-0">
            </div>

            <!-- Social Login Mockup -->
            <div class="d-grid gap-2 mb-4">
              <button type="button" class="btn btn-outline-secondary rounded-pill py-2 small d-flex align-items-center justify-content-center gap-2">
                <i class="fa-brands fa-google text-danger"></i> Continue with Google
              </button>
            </div>

            <!-- Switch to Signup -->
            <p class="text-center text-muted small mb-0">
              Don't have an account yet? 
              <a href="/signup" class="fw-bold text-danger text-decoration-none ms-1">Sign up</a>
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>