<%- layout("/layouts/boilerplate") -%>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-7 col-sm-10">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden auth-card">
        <!-- Auth Header -->
        <div class="auth-header text-center p-4 border-bottom">
          <div class="brand-icon-wrapper mx-auto mb-2">
            <i class="fa-solid fa-compass brand-icon"></i>
          </div>
          <h3 class="fw-bold text-dark mb-1">Join RoamHaven</h3>
          <p class="text-muted small mb-0">Discover extraordinary stays and connect with hosts globally</p>
        </div>

        <div class="card-body p-4 p-md-5">
          <form action="/signup" method="POST" class="needs-validation" novalidate>
            <!-- Username -->
            <div class="mb-3">
              <label for="username" class="form-label fw-semibold text-dark small">Username</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                <input 
                  name="username" 
                  type="text" 
                  id="username" 
                  class="form-control border-start-0 ps-0" 
                  placeholder="Choose a unique username" 
                  required
                >
                <div class="valid-feedback">Looks great!</div>
                <div class="invalid-feedback">Please choose a username.</div>
              </div>
            </div>

            <!-- Email -->
            <div class="mb-3">
              <label for="email" class="form-label fw-semibold text-dark small">Email Address</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-envelope text-muted"></i></span>
                <input 
                  name="email" 
                  type="email" 
                  id="email" 
                  class="form-control border-start-0 ps-0" 
                  placeholder="name@example.com" 
                  required
                >
                <div class="invalid-feedback">Please provide a valid email.</div>
              </div>
            </div>

            <!-- Password with Show/Hide Toggle -->
            <div class="mb-4">
              <label for="password" class="form-label fw-semibold text-dark small mb-1">Create Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-lock text-muted"></i></span>
                <input 
                  name="password" 
                  type="password" 
                  id="password" 
                  class="form-control border-start-0 border-end-0 px-0 password-input" 
                  placeholder="At least 6 characters" 
                  required
                >
                <button type="button" class="input-group-text bg-light border-start-0 password-toggle-btn" title="Toggle password visibility">
                  <i class="fa-regular fa-eye text-muted"></i>
                </button>
                <div class="invalid-feedback">Please enter a password.</div>
              </div>
              <small class="text-muted x-small">By signing up, you agree to RoamHaven's Terms of Service and Privacy Policy.</small>
            </div>

            <!-- Submit Button -->
            <button class="btn btn-primary-gradient w-100 py-3 rounded-pill text-white fw-bold shadow-sm mb-3">
              Create RoamHaven Account
            </button>

            <!-- Switch to Login -->
            <p class="text-center text-muted small mb-0">
              Already have an account? 
              <a href="/login" class="fw-bold text-danger text-decoration-none ms-1">Log in</a>
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>