<%- layout("/layouts/boilerplate") -%>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden haven-form-card">
        <!-- Card Header Banner -->
        <div class="haven-form-header p-4 text-white">
          <div class="d-flex align-items-center gap-3">
            <div class="form-header-icon-box">
              <i class="fa-solid fa-house-circle-check"></i>
            </div>
            <div>
              <h3 class="fw-bold mb-1">Host a New Haven</h3>
              <p class="mb-0 opacity-75 small">Share your extraordinary space with global wanderers on RoamHaven</p>
            </div>
          </div>
        </div>

        <!-- Form Body -->
        <div class="card-body p-4 p-md-5">
          <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- Title -->
            <div class="mb-4">
              <label for="title" class="form-label fw-semibold text-dark">
                Haven Title <span class="text-danger">*</span>
              </label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-heading text-muted"></i></span>
                <input 
                  name="listing[title]" 
                  id="title"
                  type="text" 
                  class="form-control border-start-0 ps-0" 
                  placeholder="e.g. Cliffside Luxury Villa with Ocean Panorama" 
                  required
                >
                <div class="invalid-feedback">Please provide a captivating title for your haven.</div>
              </div>
            </div>

            <!-- Category & Price in Row -->
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="category" class="form-label fw-semibold text-dark">
                  Category
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-tags text-muted"></i></span>
                  <select name="listing[category]" id="category" class="form-select border-start-0 ps-0">
                    <option value="Trending" selected>Trending</option>
                    <option value="Beachfront">Beachfront</option>
                    <option value="Mountains">Mountains</option>
                    <option value="Iconic Cities">Iconic Cities</option>
                    <option value="Castles">Castles</option>
                    <option value="Luxury Villas">Luxury Villas</option>
                    <option value="Amazing Pools">Amazing Pools</option>
                    <option value="Rooms">Rooms</option>
                    <option value="Camping">Camping</option>
                    <option value="Farms">Farms</option>
                    <option value="Arctic">Arctic</option>
                  </select>
                </div>
              </div>

              <div class="col-md-6">
                <label for="price" class="form-label fw-semibold text-dark">
                  Price per Night (&#8377;) <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-indian-rupee-sign text-muted"></i></span>
                  <input 
                    name="listing[price]" 
                    id="price"
                    type="number" 
                    min="1"
                    class="form-control border-start-0 ps-0" 
                    placeholder="e.g. 12500" 
                    required
                  >
                  <div class="invalid-feedback">Please enter a valid positive price.</div>
                </div>
              </div>
            </div>

            <!-- Description -->
            <div class="mb-4">
              <label for="description" class="form-label fw-semibold text-dark">
                Description <span class="text-danger">*</span>
              </label>
              <textarea 
                name="listing[description]" 
                id="description"
                rows="4" 
                class="form-control" 
                placeholder="Describe the experience, neighborhood, amenities, and unique charm..." 
                required
              ></textarea>
              <div class="invalid-feedback">Please share a detailed description for prospective guests.</div>
            </div>

            <!-- Image Upload & Preview -->
            <div class="mb-4">
              <label for="image" class="form-label fw-semibold text-dark">
                Upload Haven Image
              </label>
              <input 
                name="image" 
                id="imageUploadInput" 
                type="file" 
                class="form-control mb-2" 
                accept="image/*"
              >
              <!-- Live Image Preview Container -->
              <div id="imagePreviewBox" class="image-preview-container d-none mt-2 rounded-3 overflow-hidden border">
                <img id="imagePreviewTarget" src="" alt="Listing Preview" class="img-fluid w-100 object-fit-cover" style="max-height: 250px;">
                <div class="p-2 bg-light small text-muted text-center">Selected Image Preview</div>
              </div>
              <small class="text-muted">High-resolution photos increase bookings by up to 40%.</small>
            </div>

            <!-- Location & Country Row -->
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="location" class="form-label fw-semibold text-dark">
                  Location / City <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-map-pin text-muted"></i></span>
                  <input 
                    name="listing[location]" 
                    id="location"
                    type="text" 
                    class="form-control border-start-0 ps-0" 
                    placeholder="e.g. Udaipur, Rajasthan" 
                    required
                  >
                  <div class="invalid-feedback">Please enter the location/city.</div>
                </div>
              </div>

              <div class="col-md-6">
                <label for="country" class="form-label fw-semibold text-dark">
                  Country <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-globe text-muted"></i></span>
                  <input 
                    name="listing[country]" 
                    id="country"
                    type="text" 
                    class="form-control border-start-0 ps-0" 
                    placeholder="e.g. India" 
                    required
                  >
                  <div class="invalid-feedback">Please specify the country.</div>
                </div>
              </div>
            </div>

            <!-- Submit Button & Cancel Link -->
            <div class="d-flex align-items-center justify-content-between pt-3 border-top">
              <a href="/listings" class="btn btn-light rounded-pill px-4 text-muted">
                Cancel
              </a>
              <button type="submit" class="btn btn-primary-gradient px-5 py-2 rounded-pill text-white fw-bold shadow-sm">
                <i class="fa-solid fa-sparkles me-2"></i> Publish Haven
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>


