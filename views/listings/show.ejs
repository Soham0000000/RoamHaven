<%- layout("/layouts/boilerplate") -%>

<script>
    const mapToken = "<%= process.env.MAP_TOKAN %>";
    const listing = <%- JSON.stringify(listing) %> ;
</script>

<% const reviews = listing && listing.reviews ? listing.reviews : []; %>
<% const priceVal = listing.price || 0; %>

<div class="haven-show-page py-4">
  <!-- Top Breadcrumb & Title Section -->
  <div class="show-header-section mb-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb haven-breadcrumb mb-2">
        <li class="breadcrumb-item"><a href="/listings">Havens</a></li>
        <li class="breadcrumb-item"><a href="/listings?search=<%= encodeURIComponent(listing.country) %>"><%= listing.country %></a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= listing.location %></li>
      </ol>
    </nav>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <h1 class="show-title fw-bold text-dark mb-1"><%= listing.title %></h1>
        <div class="show-meta-bar d-flex flex-wrap align-items-center gap-3 text-muted small">
          <span class="d-flex align-items-center text-dark fw-semibold">
            <i class="fa-solid fa-star text-warning me-1"></i> 4.95 &middot; <u class="ms-1"><%= reviews.length %> reviews</u>
          </span>
          <span>&middot;</span>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1">
            <i class="fa-solid fa-crown me-1"></i> Superhost
          </span>
          <span>&middot;</span>
          <span class="location-link">
            <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= listing.location %>, <%= listing.country %>
          </span>
        </div>
      </div>

      <!-- Quick Action Buttons: Share & Wishlist -->
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-light border rounded-pill px-3 py-2 btn-share-haven" id="shareHavenBtn" title="Share this haven">
          <i class="fa-solid fa-arrow-up-from-bracket me-2"></i> Share
        </button>
        <button class="btn btn-light border rounded-pill px-3 py-2 wishlist-btn-show" data-listing-id="<%= listing._id %>" title="Save to favorites">
          <i class="fa-regular fa-heart me-2 heart-icon"></i> Save
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Photo Showcase -->
  <div class="show-gallery-wrapper mb-5">
    <div class="show-hero-image-box position-relative">
      <img 
        src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1200&q=85' %>" 
        class="show-hero-img img-fluid w-100" 
        alt="<%= listing.title %>"
      >
      <div class="hero-image-overlay-badge">
        <i class="fa-solid fa-shield-halved text-success me-1"></i> Verified RoamHaven Stay
      </div>
    </div>
  </div>

  <!-- Two Column Content Grid -->
  <div class="row g-5">
    <!-- Left Column: Details, Amenities, Host, Reviews, Map (8 cols) -->
    <div class="col-lg-8">
      <!-- Host Profile Row -->
      <div class="host-profile-box d-flex justify-content-between align-items-center pb-4 mb-4 border-bottom">
        <div>
          <h4 class="fw-bold mb-1">Entire home hosted by <%= listing.owner ? listing.owner.username : 'RoamHaven Host' %></h4>
          <p class="text-muted mb-0 small">
            6 guests &middot; 3 bedrooms &middot; 3 beds &middot; 2.5 baths
          </p>
        </div>
        <div class="host-avatar-wrapper">
          <div class="host-avatar-lg">
            <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
          </div>
          <span class="host-badge-check" title="Verified Host">
            <i class="fa-solid fa-circle-check"></i>
          </span>
        </div>
      </div>

      <!-- Stay Highlights (Airbnb Style Key Highlights) -->
      <div class="stay-highlights pb-4 mb-4 border-bottom">
        <div class="d-flex gap-3 mb-3 align-items-start">
          <div class="highlight-icon-box">
            <i class="fa-solid fa-key"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0">Self check-in</h6>
            <small class="text-muted">Check yourself in with the secure smart keypad.</small>
          </div>
        </div>
        <div class="d-flex gap-3 mb-3 align-items-start">
          <div class="highlight-icon-box">
            <i class="fa-solid fa-medal"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0"><%= listing.owner ? listing.owner.username : 'Host' %> is a Superhost</h6>
            <small class="text-muted">Superhosts are experienced, highly rated hosts committed to great stays.</small>
          </div>
        </div>
        <div class="d-flex gap-3 align-items-start">
          <div class="highlight-icon-box">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0">Free cancellation for 48 hours</h6>
            <small class="text-muted">Get a full refund if your travel plans change.</small>
          </div>
        </div>
      </div>

      <!-- About this Haven (Description) -->
      <div class="haven-description-section pb-4 mb-4 border-bottom">
        <h4 class="fw-bold mb-3">About this Haven</h4>
        <div class="haven-description-text text-secondary lh-lg">
          <%= listing.description %>
        </div>
      </div>

      <!-- What this place offers (Amenities Grid) -->
      <div class="haven-amenities-section pb-4 mb-4 border-bottom">
        <h4 class="fw-bold mb-3">What this place offers</h4>
        <div class="row row-cols-md-2 row-cols-1 g-3">
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-wifi text-muted fs-5 amenity-icon"></i>
            <span>High-speed Wi-Fi (350+ Mbps)</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-square-parking text-muted fs-5 amenity-icon"></i>
            <span>Free secure parking on premises</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-snowflake text-muted fs-5 amenity-icon"></i>
            <span>Central air conditioning & heating</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-kitchen-set text-muted fs-5 amenity-icon"></i>
            <span>Fully equipped chef's kitchen</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-laptop text-muted fs-5 amenity-icon"></i>
            <span>Dedicated ergonomic workspace</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-tv text-muted fs-5 amenity-icon"></i>
            <span>65" 4K Smart TV with Netflix/Prime</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-water-ladder text-muted fs-5 amenity-icon"></i>
            <span>Private infinity pool access</span>
          </div>
          <div class="col d-flex align-items-center gap-3">
            <i class="fa-solid fa-shield-halved text-muted fs-5 amenity-icon"></i>
            <span>24/7 security & smoke alarm</span>
          </div>
        </div>
      </div>

      <!-- Owner Actions Card (Edit / Delete) -->
      <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="owner-controls-card p-4 rounded-4 mb-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
              <h5 class="fw-bold text-dark mb-1">
                <i class="fa-solid fa-sliders text-danger me-2"></i> Haven Owner Controls
              </h5>
              <p class="text-muted small mb-0">You own this listing. You can update details or permanently remove it.</p>
            </div>
            <div class="d-flex align-items-center gap-2">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark px-4 py-2 rounded-pill fw-semibold">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Haven
              </a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Haven? This action cannot be undone.');">
                <button class="btn btn-danger px-4 py-2 rounded-pill fw-semibold">
                  <i class="fa-solid fa-trash-can me-1"></i> Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="haven-reviews-section pb-4 mb-4 border-bottom">
        <div class="d-flex align-items-center gap-2 mb-4">
          <h4 class="fw-bold mb-0">
            <i class="fa-solid fa-star text-warning me-1"></i> 4.95 &middot; <%= reviews.length %> <%= reviews.length === 1 ? 'Review' : 'Reviews' %>
          </h4>
        </div>

        <!-- Leave a Review Form for Logged In Users -->
        <% if(currUser) { %>
          <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 review-form-card">
            <h5 class="fw-bold text-dark mb-3">Leave a Review</h5>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
              <div class="mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Your Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" checked />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label for="comment" class="form-label text-muted small fw-bold text-uppercase">Your Experience</label>
                <textarea 
                  name="review[comment]" 
                  id="comment" 
                  rows="3" 
                  class="form-control rounded-3" 
                  placeholder="Share details of your stay at this haven..."
                  required
                ></textarea>
                <div class="invalid-feedback">
                  Please provide a comment about your experience.
                </div>
              </div>

              <button class="btn btn-primary-gradient px-4 py-2 rounded-pill text-white fw-semibold">
                <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
              </button>
            </form>
          </div>
        <% } else { %>
          <div class="alert alert-light border rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between">
            <span class="text-muted">Want to leave a review for this haven?</span>
            <a href="/login" class="btn btn-sm btn-outline-dark rounded-pill px-3">Log in to review</a>
          </div>
        <% } %>

        <!-- Review Cards Grid -->
        <% if(reviews.length > 0) { %>
          <div class="row g-3">
            <% for(let review of reviews){ %>
              <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 p-3 review-card">
                  <div class="card-body p-0">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <div class="user-avatar-circle user-avatar-sm">
                          <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'G' %>
                        </div>
                        <div>
                          <h6 class="fw-bold mb-0 text-dark">@<%= review.author ? review.author.username : 'Guest' %></h6>
                          <small class="text-muted"><%= new Date(review.createdAt || Date.now()).toLocaleDateString("en-US", { month: "short", year: "numeric" }) %></small>
                        </div>
                      </div>
                      
                      <!-- Only Review Author Can Delete -->
                      <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="d-inline">
                          <button class="btn btn-sm text-danger border-0 p-1 delete-review-btn" title="Delete your review">
                            <i class="fa-regular fa-trash-can"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>

                    <div class="my-2">
                      <p class="starability-result" data-rating="<%= review.rating %>">
                        Rated: <%= review.rating %> stars
                      </p>
                    </div>

                    <p class="card-text text-secondary small mb-0 review-comment-text">
                      <%= review.comment %>
                    </p>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted small fst-italic">No reviews yet. Be the first to share your experience!</p>
        <% } %>
      </div>

      <!-- Map Section -->
      <div class="haven-map-section mb-4">
        <h4 class="fw-bold mb-2">Where you'll be</h4>
        <p class="text-muted small mb-3">
          <i class="fa-solid fa-map-pin text-danger me-1"></i> <%= listing.location %>, <%= listing.country %> &middot; Precise location will be provided after reservation
        </p>
        <div id="map" class="map-container rounded-4 shadow-sm"></div>
      </div>
    </div>

    <!-- Right Column: Sticky Reservation Booking Card (4 cols) -->
    <div class="col-lg-4">
      <div class="sticky-booking-card shadow-lg rounded-4 p-4 border border-light-subtle">
        <div class="d-flex justify-content-between align-items-baseline mb-3">
          <div>
            <span class="fs-3 fw-bold text-dark">&#8377; <%= priceVal.toLocaleString("en-IN") %></span>
            <span class="text-muted"> / night</span>
          </div>
          <div class="small text-muted d-flex align-items-center gap-1">
            <i class="fa-solid fa-star text-warning"></i>
            <span class="fw-bold text-dark">4.95</span> &middot; <%= reviews.length %> reviews
          </div>
        </div>

        <!-- Date & Guest Selector Box -->
        <div class="booking-picker-box rounded-3 border mb-3 overflow-hidden">
          <div class="row g-0 border-bottom">
            <div class="col-6 p-2 border-end date-picker-cell">
              <label class="form-label text-muted x-small fw-bold mb-0">CHECK-IN</label>
              <input type="date" class="form-control border-0 p-0 shadow-none bg-transparent" id="bookingCheckin" value="2026-10-20">
            </div>
            <div class="col-6 p-2 date-picker-cell">
              <label class="form-label text-muted x-small fw-bold mb-0">CHECKOUT</label>
              <input type="date" class="form-control border-0 p-0 shadow-none bg-transparent" id="bookingCheckout" value="2026-10-25">
            </div>
          </div>
          <div class="p-2">
            <label class="form-label text-muted x-small fw-bold mb-0">GUESTS</label>
            <select class="form-select border-0 p-0 shadow-none bg-transparent" id="bookingGuests">
              <option value="1">1 guest</option>
              <option value="2" selected>2 guests</option>
              <option value="3">3 guests</option>
              <option value="4">4 guests</option>
              <option value="5">5+ guests</option>
            </select>
          </div>
        </div>

        <!-- Reserve CTA Button -->
        <button class="btn btn-primary-gradient w-100 py-3 rounded-pill text-white fw-bold fs-5 shadow-sm reserve-btn-shine mb-2" id="reserveBtn">
          Reserve Haven
        </button>
        <p class="text-center text-muted x-small mb-3">You won't be charged yet</p>

        <!-- Calculation Breakdown -->
        <div class="price-breakdown-box small text-muted">
          <div class="d-flex justify-content-between mb-2">
            <span>&#8377; <%= priceVal.toLocaleString("en-IN") %> &times; <span id="numNightsText">5</span> nights</span>
            <span class="text-dark fw-semibold" id="baseTotalText">&#8377; <%= (priceVal * 5).toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Cleaning fee</span>
            <span class="text-dark fw-semibold">&#8377; 1,200</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>RoamHaven service fee</span>
            <span class="text-dark fw-semibold">&#8377; 950</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Estimated taxes (18% GST)</span>
            <span class="text-dark fw-semibold" id="taxTotalText">&#8377; <%= Math.round(priceVal * 5 * 0.18).toLocaleString("en-IN") %></span>
          </div>
          <hr class="my-3">
          <div class="d-flex justify-content-between fs-6 fw-bold text-dark">
            <span>Total before taxes</span>
            <span id="grandTotalText">&#8377; <%= Math.round(priceVal * 5 + 1200 + 950 + (priceVal * 5 * 0.18)).toLocaleString("en-IN") %></span>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="mt-4 pt-3 border-top d-flex align-items-center gap-3 text-muted x-small">
          <i class="fa-solid fa-shield-cat fs-4 text-primary"></i>
          <span><strong>RoamHaven Cover:</strong> Every booking includes free protection against host cancellations, listing inaccuracies, and check-in issues.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Reservation Confirmation Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4 p-4 text-center">
      <div class="text-success mb-3">
        <i class="fa-solid fa-circle-check fa-4x animate-bounce"></i>
      </div>
      <h4 class="fw-bold text-dark mb-2">Reservation Request Received!</h4>
      <p class="text-muted mb-4">
        Your stay at <strong><%= listing.title %></strong> has been requested. The host will confirm your booking shortly.
      </p>
      <div class="bg-light p-3 rounded-3 text-start small mb-4">
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Haven:</span>
          <strong><%= listing.title %></strong>
        </div>
        <div class="d-flex justify-content-between mb-1">
          <span class="text-muted">Location:</span>
          <strong><%= listing.location %>, <%= listing.country %></strong>
        </div>
        <div class="d-flex justify-content-between">
          <span class="text-muted">Price per night:</span>
          <strong>&#8377; <%= priceVal.toLocaleString("en-IN") %></strong>
        </div>
      </div>
      <button type="button" class="btn btn-primary-gradient rounded-pill px-4 py-2 text-white fw-bold" data-bs-dismiss="modal">
        Awesome, Got It!
      </button>
    </div>
  </div>
</div>

<script src="/js/map.js"></script>
